{
  "name": "smart-commit",
  "version": "0.1.0",
  "description": "A read-only staged Git inspection and commit-analysis CLI.",
  "type": "module",
  "bin": {
    "git-intent": "./dist/cli.js",
    "smart-commit": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean-dist.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "git",
    "cli",
    "commit"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^15.0.0",
    "execa": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
